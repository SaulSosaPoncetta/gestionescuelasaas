@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-26: Asignar Estudiantes a Materia" as CU26
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Existencia de Materia, Ciclo Lectivo Activo\ny Registro de Estudiante (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Materia y Solicitar Incorporación" as Sec1
    usecase "Buscar y Seleccionar Estudiantes Disponibles" as Sec2
    usecase "Validar, Registrar y Sincronizar Asociaciones" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Estudiantes Asociados a la Materia\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Materia Inexistente" as Exc1
    usecase "Exc 4: No Existen Estudiantes Disponibles" as Exc4
    usecase "Exc 2: Estudiante Inexistente" as Exc2
    usecase "Exc 3: Estudiante ya Asociado" as Exc3
    usecase "Exc 5: Error de Persistencia" as Exc5

    ' Conexión del Actor al caso raíz
    Actor --> CU26

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU26 ..> Precond : <<include>>
    CU26 ..> Sec1 : <<include>>
    CU26 ..> Sec2 : <<include>>
    CU26 ..> Sec3 : <<include>>
    CU26 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc4 ..> Sec2 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
    Exc5 ..> Sec3 : <<extend>>
}
@enduml