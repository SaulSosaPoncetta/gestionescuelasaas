@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-55: Docente Consulta Alumnos de una Materia" as CU55
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado, Materia Existente\ny Alumnos Asociados (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar e Identificar Materia" as Sec1
    usecase "Consultar y Recuperar Alumnos Asociados" as Sec2
    usecase "Mostrar Listado de Alumnos en Pantalla" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Listado de Alumnos Obtenido Correctamente\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Materia Inexistente" as Exc1
    usecase "Exc 2: No Existen Alumnos Asociados" as Exc2
    usecase "Exc 3: Error Durante la Consulta" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU55

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU55 ..> Precond : <<include>>
    CU55 ..> Sec1 : <<include>>
    CU55 ..> Sec2 : <<include>>
    CU55 ..> Sec3 : <<include>>
    CU55 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
}
@enduml