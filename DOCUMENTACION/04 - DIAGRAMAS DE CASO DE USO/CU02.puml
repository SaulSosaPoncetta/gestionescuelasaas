@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actor (Generalizado como Usuario Autenticado)
actor "Usuario Autenticado" as User

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-02: Cerrar Sesión" as CU02
    
    ' --- PRECONDICIÓN ---
    usecase "Sesión Activa Existente (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Solicitar Cierre de Sesión" as Sec1
    usecase "Invalidar y Eliminar Autenticación" as Sec2
    usecase "Redirigir a Pantalla de Inicio" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Sesión Finalizada (Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Error en Invalidación" as Exc1

    ' Conexión del Actor al caso raíz
    User --> CU02

    ' Relaciones de Inclusión (Precondición, Secuencia Normal y Postcondición)
    CU02 ..> Precond : <<include>>
    CU02 ..> Sec1 : <<include>>
    CU02 ..> Sec2 : <<include>>
    CU02 ..> Sec3 : <<include>>
    CU02 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones)
    Exc1 ..> Sec2 : <<extend>>
}
@enduml