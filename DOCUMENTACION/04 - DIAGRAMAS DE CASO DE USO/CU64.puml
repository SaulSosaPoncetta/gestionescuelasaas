@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-64: Docente Actualiza su Perfil" as CU64
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado y\nPerfil Existente (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Perfil y Mostrar Datos Modificables" as Sec1
    usecase "Modificar Datos Permitidos y Confirmar Cambios" as Sec2
    usecase "Validar Información, Actualizar Datos e Informar Resultado" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Datos Modificados Registrados en el Sistema\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 3: Perfil Inexistente" as Exc3
    usecase "Exc 1: Datos Inválidos / Exc 2: Campos Obligatorios Incompletos" as Exc1_2
    usecase "Exc 4: Error Durante la Actualización" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU64

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU64 ..> Precond : <<include>>
    CU64 ..> Sec1 : <<include>>
    CU64 ..> Sec2 : <<include>>
    CU64 ..> Sec3 : <<include>>
    CU64 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc3 ..> Sec1 : <<extend>>
    Exc1_2 ..> Sec2 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml