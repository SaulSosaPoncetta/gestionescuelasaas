@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-54: Docente Consulta Perfil de una Materia" as CU54
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado y\nExistencia de la Materia (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar e Identificar Materia" as Sec1
    usecase "Consultar y Recuperar Datos Disponibles" as Sec2
    usecase "Mostrar Perfil de la Materia en Pantalla" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Información de la Materia Disponible para Consulta\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Materia Inexistente" as Exc1
    usecase "Exc 2: Materia no Asociada al Docente" as Exc2
    usecase "Exc 3: Error Durante la Consulta" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU54

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU54 ..> Precond : <<include>>
    CU54 ..> Sec1 : <<include>>
    CU54 ..> Sec2 : <<include>>
    CU54 ..> Sec3 : <<include>>
    CU54 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec1 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
}
@enduml