@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actor (Abierto a cualquier rol según plantilla)
actor "Usuario" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-31: Consultar Mesas de Examen" as CU31
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Usuario Autenticado\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Módulo y Obtener Mesas" as Sec1
    usecase "Aplicar Filtros y Procesar Búsqueda" as Sec2
    usecase "Consultar Detalle de Mesa" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Mesas Disponibles para Consulta\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: No Existen Mesas" as Exc1
    usecase "Exc 3: Error de Consulta" as Exc3
    usecase "Exc 2: Sin Resultados para los Filtros" as Exc2

    ' Conexión del Actor al caso raíz
    Actor --> CU31

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU31 ..> Precond : <<include>>
    CU31 ..> Sec1 : <<include>>
    CU31 ..> Sec2 : <<include>>
    CU31 ..> Sec3 : <<include>>
    CU31 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc3 ..> Sec1 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
}
@enduml