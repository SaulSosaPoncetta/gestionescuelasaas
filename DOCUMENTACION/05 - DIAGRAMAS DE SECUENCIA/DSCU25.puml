@startuml
skinparam monochrome true
skinparam shadowlighting false

<style>
  box {
    BackgroundColor transparent
  }
</style>

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 12

actor "Administrador / Secretaría" as Actor
box "Capa de Presentación" 
    participant "AsignacionDocenteUI\n(Pantalla)" as UI
end box
box "Capa de Negocio" 
    participant "MateriaDocenteController" as Ctrl
end box
box "Capa de Datos" 
    participant "Base de Datos" as DB
end box

== Fase 1: Selección de Materia y Carga de Docentes ==

Actor -> UI: Seleccionar una materia del listado
activate UI

Actor -> UI: Solicitar asignar docente

UI -> Ctrl: obtenerDocentesDisponibles(materiaId)
activate Ctrl

== Verificación de Materia (Precondición 1) ==
Ctrl -> DB: verificarMateriaExiste(materiaId)
activate DB
return materiaExiste

alt Excepción 1: Materia inexistente
    Ctrl --> UI: error: La materia no existe
    UI --> Actor: Mostrar mensaje "Error: La materia seleccionada no es válida"
else Materia válida
    
    Ctrl -> DB: obtenerListadoDocentesActivos()
    activate DB
    return listaDocentes
    
    Ctrl --> UI: mostrarDocentesDisponibles(listaDocentes)
    deactivate Ctrl
    UI --> Actor: El sistema muestra el listado de docentes disponibles en el sistema
    deactivate UI

    == Fase 2: Selección de Docente y Registro de Relación ==

    Actor -> UI: Seleccionar un docente y confirmar la operación
    activate UI
    
    UI -> Ctrl: asignarDocenteAMateria(materiaId, docenteId)
    activate Ctrl
    
    == Verificación de Docente (Precondición 2) ==
    Ctrl -> DB: verificarDocenteExiste(docenteId)
    activate DB
    return docenteExiste
    
    alt Excepción 2: Docente inexistente
        Ctrl --> UI: error: El docente no existe
        UI --> Actor: Mostrar mensaje "Error: El docente seleccionado ya no figura en el sistema"
        
    else Docente válido
        
        == Verificación de Asociación Previa (Precondición 3) ==
        Ctrl -> DB: verificarAsociacionExistente(materiaId, docenteId)
        activate DB
        return estaAsignado
        
        alt Excepción 3: Docente ya asignado
            Ctrl --> UI: error: El docente ya se encuentra asociado a esta materia
            UI --> Actor: Mostrar mensaje "Advertencia: Este docente ya dicta la materia seleccionada"
            
        else Asignación nueva y válida
            
            Ctrl -> DB: insertarRelacionMateriaDocente(materiaId, docenteId)
            activate DB
            
            alt Excepción 4: Error de persistencia (Fallo físico en base de datos)
                DB --> Ctrl: error: SQLException / ConnectionTimeout
                Ctrl --> UI: error: No se pudo registrar la relación
                UI --> Actor: Mostrar mensaje "Error interno de almacenamiento, intente nuevamente"
            else Escritura exitosa (Flujo Normal)
                return confirmacionOK
                
                Ctrl --> UI: asignacionExitosaConfirmada
                deactivate Ctrl
                UI --> Actor: El sistema confirma la operación: "Docente asociado a la materia"
                deactivate UI
            end
        end
    end
end

@enduml