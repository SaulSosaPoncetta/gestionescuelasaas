@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-58: Docente Restaura Alumno a Cursando" as CU58
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado, Materia Existente\ny Alumno Asociado a la Materia (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Materia y Mostrar Alumnos" as Sec1
    usecase "Seleccionar Alumno y Solicitar Restaurar Estado" as Sec2
    usecase "Procesar Solicitud, Actualizar Estado de Cursada e Informar Resultado" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Estado de Cursada Establecido Nuevamente como Cursando\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 3: Materia Inexistente" as Exc3
    usecase "Exc 1: Alumno Inexistente / Exc 2: No Existe Inscripción Correspondiente" as Exc1_2
    usecase "Exc 4: Error Durante la Actualización" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU58

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU58 ..> Precond : <<include>>
    CU58 ..> Sec1 : <<include>>
    CU58 ..> Sec2 : <<include>>
    CU58 ..> Sec3 : <<include>>
    CU58 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc3 ..> Sec1 : <<extend>>
    Exc1_2 ..> Sec2 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml