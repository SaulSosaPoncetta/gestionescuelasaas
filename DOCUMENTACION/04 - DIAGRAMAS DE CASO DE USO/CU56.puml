@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-56: Docente Carga Notas" as CU56
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado, Materia Existente\ny Alumno Inscripto (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Materia y Mostrar Alumnos" as Sec1
    usecase "Ingresar Notas y Confirmar Operación" as Sec2
    usecase "Validar Datos, Registrar Notas y Confirmar Operación" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Notas Registradas en el Sistema\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 3: Materia Inexistente" as Exc3
    usecase "Exc 2: Alumno no Inscripto en la Materia" as Exc2
    usecase "Exc 1: Nota Inválida / Exc 5: Datos Incompletos" as Exc1
    usecase "Exc 4: Error Durante el Registro" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU56

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU56 ..> Precond : <<include>>
    CU56 ..> Sec1 : <<include>>
    CU56 ..> Sec2 : <<include>>
    CU56 ..> Sec3 : <<include>>
    CU56 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc3 ..> Sec1 : <<extend>>
    Exc2 ..> Sec1 : <<extend>>
    Exc1 ..> Sec2 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml