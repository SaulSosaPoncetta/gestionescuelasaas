@startuml
skinparam monochrome true
skinparam shadowlighting false

<style>
  box {
    BackgroundColor transparent
  }
</style>

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 12

actor "Administrador / Secretaría" as Actor

box "Capa de Presentación" 
    participant "MesaExamenUI\n(Pantalla)" as UI
end box

box "Capa de Negocio" 
    participant "MesaExamenController" as Ctrl
    participant "SessionManager" as Session
end box

box "Capa de Datos" 
    participant "Base de Datos" as DB
end box


== Fase 1: Selección de Mesa ==

Actor -> UI: Seleccionar mesa de examen
activate UI

UI -> Ctrl: consultarMesa(idMesa)
activate Ctrl

== Verificación de Precondición ==

Ctrl -> Session: verificarSesionActiva()
activate Session
return sesionValidaOk

alt Sesión no válida

    Ctrl --> UI: error: Usuario no autenticado
    UI --> Actor: Mostrar mensaje de acceso no autorizado

else Sesión válida

    Ctrl -> DB: consultarMesa(idMesa)
    activate DB
    return mesa

    alt Excepción 3: Mesa inexistente

        Ctrl --> UI: error: La mesa no existe
        UI --> Actor: Mostrar mensaje "La mesa de examen seleccionada no existe"

    else Mesa existente

        == Fase 2: Agregar Estudiantes ==

        Actor -> UI: Solicitar agregar estudiantes

        UI -> Ctrl: obtenerEstudiantesDisponibles()
        activate Ctrl

        Ctrl -> DB: consultarEstudiantesDisponibles()
        activate DB
        return listaEstudiantes

        alt Excepción 4: No existen estudiantes disponibles

            Ctrl --> UI: error: No existen estudiantes disponibles
            UI --> Actor: Mostrar mensaje "No existen estudiantes disponibles"

        else Existen estudiantes disponibles

            Ctrl --> UI: mostrarEstudiantes(listaEstudiantes)
            UI --> Actor: Mostrar estudiantes disponibles

            Actor -> UI: Seleccionar uno o varios estudiantes
            Actor -> UI: Confirmar

            UI -> Ctrl: registrarInscripciones(estudiantes)
            
            Ctrl -> DB: registrarInscripciones(estudiantes)
            activate DB

            alt Excepción 1: Estudiante ya inscripto

                DB --> Ctrl: error: Estudiante ya inscripto
                Ctrl --> UI: error: El estudiante ya está inscripto
                UI --> Actor: Mostrar mensaje "El estudiante ya se encuentra inscripto en la mesa"

            else Estudiante no inscripto

                alt Excepción 2: Estudiante no correspondiente a la materia

                    DB --> Ctrl: error: Estudiante no correspondiente a la materia
                    Ctrl --> UI: error: El estudiante no corresponde a la materia
                    UI --> Actor: Mostrar mensaje "El estudiante no corresponde a la materia"

                else Estudiante correspondiente

                    return inscripcionesRegistradas

                    Ctrl --> UI: confirmarOperacion
                    deactivate Ctrl

                    UI --> Actor: El sistema confirma la operación: "Estudiantes incorporados a la mesa"
                    deactivate UI

                end
            end

            deactivate DB

        end
    end
end

@enduml