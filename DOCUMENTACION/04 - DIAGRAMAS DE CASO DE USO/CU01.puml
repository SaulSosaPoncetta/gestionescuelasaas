@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador" as Admin
actor "Secretaría" as Sec
actor "Docente" as Doc
actor "Estudiante" as Est

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-01: Iniciar Sesión" as CU01
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Registro y Habilitación" as Precond
    
    ' --- SECUENCIA NORMAL (Componentes clave) ---
    usecase "Ingresar Credenciales" as Sec1
    usecase "Validar Usuario y Contraseña" as Sec2
    usecase "Crear Sesión y Redirigir según Perfil" as Sec3
    
    ' --- POSTCONDICIONES ---
    usecase "Habilitar Acceso Autorizado (Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1 y 2: Credenciales Incorrectas / Inexistente" as Exc1
    usecase "Exc 3: Usuario Inactivo" as Exc3
    usecase "Exc 4: Datos Incompletos" as Exc4
    usecase "Exc 5: Error de Conexión BD" as Exc5

    ' Conexión de Actores al caso raíz
    Admin --> CU01
    Sec --> CU01
    Doc --> CU01
    Est --> CU01

    ' Relaciones de Inclusión (Precondiciones y Secuencia Normal Obligatoria)
    CU01 ..> Precond : <<include>>
    CU01 ..> Sec1 : <<include>>
    CU01 ..> Sec2 : <<include>>
    CU01 ..> Sec3 : <<include>>
    CU01 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones / Flujos de Error)
    Exc1 ..> Sec2 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
    Exc4 ..> Sec1 : <<extend>>
    Exc5 ..> Sec2 : <<extend>>
}
@enduml