@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Estudiante" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-38: Consultar Finales Disponibles" as CU38
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Estudiante Autenticado y\nCarrera Activa (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Módulo e Identificar Carrera" as Sec1
    usecase "Consultar Materias y Verificar Situación Académica" as Sec2
    usecase "Determinar y Mostrar Mesas Disponibles" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Visualizar Finales Disponibles\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Estudiante sin Carrera Activa" as Exc1
    usecase "Exc 4: Error de Consulta" as Exc4
    usecase "Exc 3: Materias sin Condición para Rendir" as Exc3
    usecase "Exc 2: No Existen Mesas Disponibles" as Exc2

    ' Conexión del Actor al caso raíz
    Actor --> CU38

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU38 ..> Precond : <<include>>
    CU38 ..> Sec1 : <<include>>
    CU38 ..> Sec2 : <<include>>
    CU38 ..> Sec3 : <<include>>
    CU38 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc4 ..> Sec1 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
}
@enduml