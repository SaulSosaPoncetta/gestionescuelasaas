@startuml
skinparam monochrome true
skinparam shadowlighting false

<style>
  box {
    BackgroundColor transparent
  }
</style>

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 12

actor "Administrador / Secretaría" as Actor
box "Capa de Presentación" 
    participant "AdminGestionUI\n(Pantalla)" as UI
end box
box "Capa de Negocio" 
    participant "AdminController" as Ctrl
    participant "SessionManager" as Session
end box
box "Capa de Datos" 
    participant "Base de Datos" as DB
end box

== Fase 1: Selección y Carga de Datos Existentes ==

Actor -> UI: Seleccionar un administrador del listado
activate UI

UI -> Ctrl: cargarDatosParaModificacion(adminId)
activate Ctrl

Ctrl -> Session: verificarSesiónActiva()
activate Session
deactivate Session

Ctrl -> DB: buscarAdministradorPorId(adminId)
activate DB

alt Excepción 1: Administrador inexistente
    DB --> Ctrl: registroNoEncontrado
    Ctrl --> UI: error: Administrador no existe
    UI --> Actor: Mostrar mensaje "El administrador seleccionado ya no existe en el sistema"
else Administrador encontrado con éxito
    return datosAdministrador
    
    Ctrl --> UI: mostrarFormularioEdicion(datosAdministrador)
    deactivate Ctrl
    UI --> Actor: El sistema muestra el formulario con los datos actuales cargados
    deactivate UI

    == Fase 2: Modificación, Validación y Persistencia ==

    Actor -> UI: Modificar la información y confirmar la operación
    activate UI
    
    UI -> Ctrl: actualizarAdministrador(adminId, nuevosDatos)
    activate Ctrl
    
    Ctrl -> Ctrl: validarNuevosDatos(nuevosDatos)
    
    alt Excepción 2: Datos inválidos
        Ctrl --> UI: error: Datos inválidos según reglas de negocio
        UI --> Actor: Mostrar campos con error y solicitar corrección
    else Datos válidos
        
        Ctrl -> DB: modificarRegistroAdministrador(adminId, nuevosDatos)
        activate DB
        
        alt Excepción 3: Error de actualización
            DB --> Ctrl: error: Fallo en persistencia / Conexión
            Ctrl --> UI: error: No se pudo guardar la información
            UI --> Actor: Mostrar mensaje "Error interno al actualizar el registro, intente de nuevo"
        else Actualización exitosa
            return confirmacionOK
            
            Ctrl --> UI: modificacionExitosaConfirmada
            deactivate Ctrl
            UI --> Actor: El sistema confirma la operación: "Los datos quedan actualizados"
            deactivate UI
        end
    end
end

@enduml