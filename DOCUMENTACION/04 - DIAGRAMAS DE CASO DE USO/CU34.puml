@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-34: Agregar Estudiante a Mesa" as CU34
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Existencia de Mesa, Registro de Estudiante\ny Correspondencia con Materia (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Mesa y Solicitar Agregar Estudiantes" as Sec1
    usecase "Obtener y Seleccionar Estudiantes Disponibles" as Sec2
    usecase "Validar y Registrar Inscripciones" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Estudiantes Incorporados a la Mesa\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 3: Mesa Inexistente" as Exc3
    usecase "Exc 4: No Existen Estudiantes Disponibles" as Exc4
    usecase "Exc 2: Estudiante no Correspondiente a Materia" as Exc2
    usecase "Exc 1: Estudiante ya Inscripto" as Exc1

    ' Conexión del Actor al caso raíz
    Actor --> CU34

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU34 ..> Precond : <<include>>
    CU34 ..> Sec1 : <<include>>
    CU34 ..> Sec2 : <<include>>
    CU34 ..> Sec3 : <<include>>
    CU34 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc3 ..> Sec1 : <<extend>>
    Exc4 ..> Sec2 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
    Exc1 ..> Sec3 : <<extend>>
}
@enduml