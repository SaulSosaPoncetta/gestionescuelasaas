@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-20: Modificar Carrera" as CU20
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Existencia de la Carrera\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Carrera y Mostrar Datos" as Sec1
    usecase "Modificar Información y Confirmar" as Sec2
    usecase "Validar y Actualizar Carrera" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Carrera Actualizada en Sistema\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Carrera Inexistente" as Exc1
    usecase "Exc 2: Datos Inválidos" as Exc2
    usecase "Exc 3: Error de Actualización" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU20

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU20 ..> Precond : <<include>>
    CU20 ..> Sec1 : <<include>>
    CU20 ..> Sec2 : <<include>>
    CU20 ..> Sec3 : <<include>>
    CU20 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
}
@enduml