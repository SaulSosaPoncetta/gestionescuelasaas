@startuml
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center

actor "Docente" as Docente
boundary "PantallaHistorialFinales" as Vista
control "FinalesDocController" as Ctrl
entity "HistorialService" as Service
database "BaseDeDatos" as BD

title Diagrama de Secuencia - CU-60: Docente Consulta Historial de Finales

Docente -> Vista : Acceder al historial de finales
activate Vista
Vista -> Ctrl : obtenerHistorialFinales()
activate Ctrl

Ctrl -> Service : consultarHistorialFinalesDocente(idDocenteAutenticado)
activate Service
Service -> BD : buscarRegistroHistoricoFinales(idDocente)
activate BD
BD --> Service : ListaHistorial / ListaVacía / Error
deactivate BD

alt Excepción 1: No existen registros históricos
    Service --> Ctrl : ListaVacía()
    Ctrl --> Vista : Mostrar mensaje ("Sin historial de finales disponible")
    Vista --> Docente : Informar ausencia de historial
else Excepción 2: Error durante la consulta
    Service --> Ctrl : Error("Error en base de datos")
    Ctrl --> Vista : Mostrar mensaje de error
    Vista --> Docente : Informar falla del sistema
else Consulta Exitosa (Secuencia Normal)
    Service --> Ctrl : ListaHistorial
    deactivate Service
    Ctrl --> Vista : MostrarHistorial(ListaHistorial)
    deactivate Ctrl
    Vista --> Docente : Presentar información histórica de finales
    deactivate Vista
end

@enduml