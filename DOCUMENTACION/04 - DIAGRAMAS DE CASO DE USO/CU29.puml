@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-29: Restaurar Estudiante en Materia" as CU29
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Asociación del Estudiante y\nSituación Modificable (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Materia y Estudiante" as Sec1
    usecase "Solicitar Restauración y Actualizar Situación" as Sec2
    
    ' --- POSTCONDICIÓN ---
    usecase "Estudiante Reestablecido en Situación de Cursada\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 2: Materia Inexistente" as Exc2
    usecase "Exc 1: Estudiante Inexistente" as Exc1
    usecase "Exc 3: Error de Actualización" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU29

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU29 ..> Precond : <<include>>
    CU29 ..> Sec1 : <<include>>
    CU29 ..> Sec2 : <<include>>
    CU29 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc2 ..> Sec1 : <<extend>>
    Exc1 ..> Sec1 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
}
@enduml