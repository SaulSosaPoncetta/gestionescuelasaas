@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-23: Registrar Materia" as CU23
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Existencia de la Carrera\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Carrera y Solicitar Agregar Materia" as Sec1
    usecase "Ingresar Datos de la Materia" as Sec2
    usecase "Validar, Registrar y Asociar Materia a Carrera" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Materia Registrada y Asociada a la Carrera\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Carrera Inexistente" as Exc1
    usecase "Exc 2: Datos Inválidos" as Exc2
    usecase "Exc 3: Materia Duplicada" as Exc3
    usecase "Exc 4: Error de Persistencia" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU23

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU23 ..> Precond : <<include>>
    CU23 ..> Sec1 : <<include>>
    CU23 ..> Sec2 : <<include>>
    CU23 ..> Sec3 : <<include>>
    CU23 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml