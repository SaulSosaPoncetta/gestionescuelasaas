@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-33: Modificar Mesa de Examen" as CU33
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Existencia de la Mesa\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Mesa y Mostrar Información" as Sec1
    usecase "Modificar Datos y Confirmar" as Sec2
    usecase "Validar y Actualizar Mesa" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Mesa de Examen Actualizada\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Mesa Inexistente" as Exc1
    usecase "Exc 3: Datos Incompletos" as Exc3
    usecase "Exc 2: Fecha Inválida" as Exc2
    usecase "Exc 4: Error de Actualización" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU33

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU33 ..> Precond : <<include>>
    CU33 ..> Sec1 : <<include>>
    CU33 ..> Sec2 : <<include>>
    CU33 ..> Sec3 : <<include>>
    CU33 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml