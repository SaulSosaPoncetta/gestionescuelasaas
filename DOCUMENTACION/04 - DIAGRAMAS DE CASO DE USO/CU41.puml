@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Estudiante" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-41: Consultar Carrera como Estudiante" as CU41
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Estudiante Autenticado\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a 'Mi Carrera' e Identificar Estudiante" as Sec1
    usecase "Recuperar y Mostrar Datos Académicos de la Carrera" as Sec2
    
    ' --- POSTCONDICIÓN ---
    usecase "Información de la Carrera Disponible para Consulta\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Estudiante sin Carrera Asignada" as Exc1
    usecase "Exc 2: Error de Consulta" as Exc2

    ' Conexión del Actor al caso raíz
    Actor --> CU41

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU41 ..> Precond : <<include>>
    CU41 ..> Sec1 : <<include>>
    CU41 ..> Sec2 : <<include>>
    CU41 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
}
@enduml