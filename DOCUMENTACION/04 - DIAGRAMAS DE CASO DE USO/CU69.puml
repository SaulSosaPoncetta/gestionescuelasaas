@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Alumno" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-69: Estudiante se Matricula en una Materia" as CU69
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Alumno Autenticado y\nMateria Disponible para Matriculación (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Sección y Mostrar Materias Disponibles" as Sec1
    usecase "Seleccionar Materia y Verificar Condiciones" as Sec2
    usecase "Registrar Matriculación e Informar Resultado Operación" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Matriculación Registrada en el Sistema\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Materia no Disponible / Exc 2: Alumno Ya Matriculado" as Exc1_2
    usecase "Exc 3: Alumno no Cumple Condiciones Requeridas" as Exc3
    usecase "Exc 4: Error al Registrar la Matriculación" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU69

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU69 ..> Precond : <<include>>
    CU69 ..> Sec1 : <<include>>
    CU69 ..> Sec2 : <<include>>
    CU69 ..> Sec3 : <<include>>
    CU69 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1_2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml