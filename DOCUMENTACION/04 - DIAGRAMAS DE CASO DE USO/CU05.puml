@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actor
actor "Usuario Autenticado" as User

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-05: Modificar Perfil" as CU05
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Autenticación y Perfil Asociado\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Perfil y Solicitar Modificación" as Sec1
    usecase "Completar Formulario y Confirmar" as Sec2
    usecase "Validar y Actualizar Datos" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Datos del Perfil Actualizados\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Datos Inválidos" as Exc1
    usecase "Exc 2: Campos Obligatorios Incompletos" as Exc2
    usecase "Exc 3: Error de Actualización en Base de Datos" as Exc3

    ' Conexión del Actor al caso raíz
    User --> CU05

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU05 ..> Precond : <<include>>
    CU05 ..> Sec1 : <<include>>
    CU05 ..> Sec2 : <<include>>
    CU05 ..> Sec3 : <<include>>
    CU05 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones que interrumpen pasos específicos)
    Exc1 ..> Sec3 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
}
@endif