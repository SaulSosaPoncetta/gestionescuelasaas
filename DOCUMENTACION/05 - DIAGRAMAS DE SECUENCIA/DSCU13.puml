@startuml
skinparam monochrome true
skinparam shadowlighting false

<style>
  box {
    BackgroundColor transparent
  }
</style>

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 12

actor "Administrador / Secretaría" as Actor
box "Capa de Presentación" 
    participant "DocenteGestionUI\n(Pantalla)" as UI
end box
box "Capa de Negocio" 
    participant "DocenteController" as Ctrl
end box
box "Capa de Datos" 
    participant "Base de Datos" as DB
end box

== Inicio del Caso de Uso ==

Actor -> UI: Seleccionar un docente del listado
activate UI

Actor -> UI: Solicitar cambiar su estado (Activar / Desactivar)

UI -> Ctrl: cambiarEstadoDocente(docenteId)
activate Ctrl

== Verificación de Registro (Precondición) ==

Ctrl -> DB: verificarExistenciaYEstado(docenteId)
activate DB

alt Excepción 1: Docente inexistente
    DB --> Ctrl: registroNoEncontrado
    Ctrl --> UI: error: Docente no existe
    UI --> Actor: Mostrar mensaje "El docente seleccionado no existe en el sistema"
else Docente registrado con éxito
    return registroActual
    
    == Procesamiento y Actualización del Estado ==
    
    Ctrl -> Ctrl: alternarEstado(registroActual.estado)
    
    Ctrl -> DB: actualizarEstadoDocente(docenteId, nuevoEstado)
    activate DB
    
    alt Excepción 2: Error de actualización
        DB --> Ctrl: error: Fallo en persistencia / Conexión
        Ctrl --> UI: error: No se pudo modificar el estado
        UI --> Actor: Mostrar mensaje "Error interno al actualizar el estado, intente de nuevo"
    else Transacción exitosa
        return confirmacionOK
        
        Ctrl --> UI: cambioEstadoExitoso(nuevoEstado)
        deactivate Ctrl
        UI --> Actor: El sistema confirma la operación: "Estado del docente actualizado"
        deactivate UI
    end
end

@enduml