@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Administrador / Secretaría" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-16: Modificar Estudiante" as CU16
    
    ' --- PRECONDICIÓN ---
    usecase "Verificar Existencia del Estudiante\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Estudiante y Mostrar Información" as Sec1
    usecase "Modificar Datos y Confirmar" as Sec2
    usecase "Validar y Actualizar Registro" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Información Actualizada en Sistema\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Estudiante Inexistente" as Exc1
    usecase "Exc 2: Datos Inválidos" as Exc2
    usecase "Exc 3: Error de Actualización" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU16

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU16 ..> Precond : <<include>>
    CU16 ..> Sec1 : <<include>>
    CU16 ..> Sec2 : <<include>>
    CU16 ..> Sec3 : <<include>>
    CU16 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec1 : <<extend>>
    Exc2 ..> Sec3 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
}
@enduml