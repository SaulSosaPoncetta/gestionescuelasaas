@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Alumno" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-65: Estudiante Inicia Sesión" as CU65
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Alumno Registrado y\nCredenciales Válidas (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Pantalla de Inicio y Solicitar Credenciales" as Sec1
    usecase "Ingresar Credenciales y Validar Datos" as Sec2
    usecase "Verificar Rol, Autenticar y Redirigir al Inicio" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Alumno Autenticado con Acceso Habilitado a su Rol\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Credenciales Incorrectas / Exc 2: Usuario no Registrado" as Exc1_2
    usecase "Exc 3: Usuario sin Rol Requerido" as Exc3
    usecase "Exc 4: Error Durante la Autenticación" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU65

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU65 ..> Precond : <<include>>
    CU65 ..> Sec1 : <<include>>
    CU65 ..> Sec2 : <<include>>
    CU65 ..> Sec3 : <<include>>
    CU65 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1_2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec3 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml