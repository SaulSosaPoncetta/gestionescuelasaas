@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Alumno" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-76: Estudiante Consulta Sus Datos" as CU76
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Alumno Autenticado\n(Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Sección e Identificar Alumno Autenticado" as Sec1
    usecase "Recuperar Información Correspondiente" as Sec2
    usecase "Presentar Datos del Alumno en Pantalla" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Datos Personales Disponibles para Visualización\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: No se Encuentran Datos Asociados" as Exc1
    usecase "Exc 2: Error al Recuperar la Información" as Exc2

    ' Conexión del Actor al caso raíz
    Actor --> CU76

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU76 ..> Precond : <<include>>
    CU76 ..> Sec1 : <<include>>
    CU76 ..> Sec2 : <<include>>
    CU76 ..> Sec3 : <<include>>
    CU76 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1 ..> Sec2 : <<extend>>
    Exc2 ..> Sec2 : <<extend>>
}
@enduml