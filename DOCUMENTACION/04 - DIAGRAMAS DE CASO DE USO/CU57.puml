@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Docente" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-57: Docente Reprueba a Alumno" as CU57
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Docente Autenticado, Materia Existente\ny Alumno Asociado a la Materia (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Seleccionar Materia y Mostrar Alumnos" as Sec1
    usecase "Seleccionar Alumno y Solicitar Reprobar" as Sec2
    usecase "Procesar Solicitud, Actualizar Estado e Informar Resultado" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Estado de Cursada del Alumno Registrado como Reprobado\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 3: Materia Inexistente" as Exc3
    usecase "Exc 1: Alumno Inexistente / Exc 2: Alumno no Asociado" as Exc1_2
    usecase "Exc 4: Error Durante la Actualización" as Exc4

    ' Conexión del Actor al caso raíz
    Actor --> CU57

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU57 ..> Precond : <<include>>
    CU57 ..> Sec1 : <<include>>
    CU57 ..> Sec2 : <<include>>
    CU57 ..> Sec3 : <<include>>
    CU57 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc3 ..> Sec1 : <<extend>>
    Exc1_2 ..> Sec2 : <<extend>>
    Exc4 ..> Sec3 : <<extend>>
}
@enduml