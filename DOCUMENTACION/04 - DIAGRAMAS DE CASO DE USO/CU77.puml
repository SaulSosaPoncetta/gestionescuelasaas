@startuml
left to right direction
skinparam packageStyle rectangle

' Definición de Actores
actor "Alumno" as Actor

rectangle "Sistema de Gestión Institucional" {
    
    ' Caso de Uso Principal
    usecase "CU-77: Estudiante Consulta Analítico" as CU77
    
    ' --- PRECONDICIONES ---
    usecase "Verificar Alumno Autenticado e\nInformación Académica Registrada (Precondición)" as Precond
    
    ' --- SECUENCIA NORMAL ---
    usecase "Acceder a Opción e Identificar Alumno Autenticado" as Sec1
    usecase "Consultar e Recuperar Resultados Académicos" as Sec2
    usecase "Generar y Mostrar Analítico en Pantalla" as Sec3
    
    ' --- POSTCONDICIÓN ---
    usecase "Información Académica Consolidada Disponible\n(Postcondición)" as Post
    
    ' --- EXCEPCIONES ---
    usecase "Exc 1: Sin Información Registrada / Exc 2: Sin Datos Suficientes" as Exc1_2
    usecase "Exc 3: Error Durante la Consulta" as Exc3

    ' Conexión del Actor al caso raíz
    Actor --> CU77

    ' Relaciones de Inclusión (Precondiciones, Secuencia Normal y Postcondición)
    CU77 ..> Precond : <<include>>
    CU77 ..> Sec1 : <<include>>
    CU77 ..> Sec2 : <<include>>
    CU77 ..> Sec3 : <<include>>
    CU77 ..> Post : <<include>>

    ' Relaciones de Extensión (Excepciones vinculadas al paso correspondiente)
    Exc1_2 ..> Sec2 : <<extend>>
    Exc3 ..> Sec2 : <<extend>>
}
@enduml